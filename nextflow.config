// ========================================
// Pipeline Parameters
// ========================================
params {
    // Input/Output
    input  = null
    outdir = './results'
    
    // SCENIC database paths - REQUIRED for SCENIC analysis
    // Download from: https://resources.aertslab.org/cistarget/
    scenic_motif_db      = null
    scenic_annotation_db = null
    scenic_tfs           = null
    
    // Resource defaults
    max_cpus   = 16
    max_memory = '64.GB'
    max_time   = '24.h'
}

// ========================================
// Process Configuration；
// ========================================
process {
    // Default resources
    cpus   = 2
    memory = 8.GB
    time   = 4.h
    
    // Container settings
    withName: SCVELO {
        container = 'my-scvelo:latest'
    }
    
//    withName: CELLCHAT {
//        container = 'rocker/tidyverse:latest'
//    }
    
    withName: 'PYSCENIC_.*' {
        container = 'my-pyscenic:custom'
        cpus      = 16
        memory    = 64.GB
        time      = 12.h
    }
}

// ========================================
// Execution Profiles
// ========================================
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    
    local {
        process.executor = 'local'
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
    }
}

// ========================================
// Manifest
// ========================================
manifest {
    name            = 'scenic_nextflow'
    author          = 'ShepherdZh'
    description     = 'Single-cell RNA-seq downstream analysis pipeline: SCENIC + scVelo + CellChat'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
